[Unit]
Description=MuxCore Module - ratelimit-tokenbucket
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=muxcore
Group=muxcore
ExecStart=/usr/local/bin/ratelimit-tokenbucket --muxcore-mesh-addr localhost:9090 --muxcore-module-id ratelimit-tokenbucket
Environment=RATELIMIT_RATE=100 RATELIMIT_BURST=200 RATELIMIT_ENABLED=true
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
