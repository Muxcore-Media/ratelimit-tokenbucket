# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_MODULE_ID=ratelimit-tokenbucket

# gRPC listen (default 127.0.0.1:9800; TLS enabled unless insecure below)
# RATELIMIT_GRPC_ADDR=127.0.0.1:9800

# Rate limiter
# RATELIMIT_RATE=100
# RATELIMIT_BURST=200
# RATELIMIT_ENABLED=true

# TLS (optional; auto-generated under ~/.muxcore/tls/ratelimit-tokenbucket when unset)
# RATELIMIT_TLS_CERT=
# RATELIMIT_TLS_KEY=
# RATELIMIT_TLS_CA=
# RATELIMIT_TLS_DIR=

# Dev only — disable inbound and outbound gRPC TLS
# MUXCORE_INSECURE_DISABLE_TLS=true
